# Copie para .env e ajuste conforme necessário
# ===== Banco de dados (Postgres) =====
# Em produção, use a URL pooled da Neon para DATABASE_URL e a URL direta para
# DIRECT_URL. No Docker local, ambas apontam para o mesmo Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/screenshare?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/screenshare?schema=public"

# ===== LiveKit =====
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret-key-change-me"

# Optional: comma-separated LAN hostnames/IPs allowed by Next.js dev asset
# protection. Leave empty unless you access the dev server from another device.
DEV_ALLOWED_ORIGINS=""

# ===== Sala =====
ROOM_INACTIVITY_TTL_SEC=3600

# Obrigatório em produção. O Vercel Cron envia este valor automaticamente no
# header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-a-long-random-secret"
